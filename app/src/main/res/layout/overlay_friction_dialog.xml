<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E60F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp"
        android:background="@drawable/dialog_background">

        <!-- Glowing Zen Mindfulness Circle -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/zen_circle_glow" />

            <TextView
                android:id="@+id/tv_countdown_seconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="10"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MINDFUL PAUSE"
            android:textColor="@color/zen_light_purple"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Take a deep breath."
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Do you actually want to watch Reels right now, or is it just an impulse habit?"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="24dp" />

        <!-- Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_leave_reels"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="✓ Leave &amp; Return to Life"
            android:textColor="@color/bg_dark"
            android:textStyle="bold"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/status_green"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_grant_pass"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Allow 15 Minutes Pass (Wait 10s)"
            android:textColor="@color/zen_light_purple"
            android:textSize="13sp"
            android:enabled="false" />

    </LinearLayout>

</FrameLayout>
